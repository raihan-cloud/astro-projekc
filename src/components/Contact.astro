---
const contactInfo = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
    label: 'Email',
    value: 'raihanmuzaffar2319@gmail.com',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
    label: 'LinkedIn',
    value: 'Raihan Muzaffar',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
    label: 'Location',
    value: 'Indonesia',
  },
];
---

<section id="contact" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">

    <div class="text-center mb-16" data-animate>
      <p class="text-blue-600 font-semibold tracking-widest text-sm uppercase mb-2">Get In Touch</p>
      <h2 class="font-display font-bold text-4xl text-slate-800">Let's <span class="text-blue-600">Connect</span></h2>
      <p class="text-slate-400 mt-4 max-w-md mx-auto">
        Tertarik untuk berkolaborasi atau mendiskusikan arsitektur sistem? Saya selalu terbuka untuk tantangan baru.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-16 items-start">

      <!-- Left: Info -->
      <div class="space-y-8" data-animate>
        <div>
          <h3 class="font-display font-bold text-2xl text-slate-800 mb-3">Discuss a Project</h3>
          <p class="text-slate-500 leading-relaxed">
            Apakah Anda memerlukan bantuan untuk mengotomatisasi pipeline deployment, mengelola infrastruktur cloud, atau membangun dashboard IoT? Silakan kirimkan pesan dan saya akan merespons dalam waktu singkat.
          </p>
        </div>

        <div class="space-y-4">
          {contactInfo.map(info => (
            <div class="flex items-center gap-4 p-4 rounded-2xl border border-slate-100 hover:border-blue-200 hover:shadow-sm transition-all duration-200 group">
              <div class="w-11 h-11 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-blue-600 transition-colors">
                <svg class="w-5 h-5 text-blue-600 group-hover:text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <Fragment set:html={info.icon} />
                </svg>
              </div>
              <div>
                <p class="text-xs text-slate-400 font-medium uppercase tracking-wide">{info.label}</p>
                <p class="text-slate-700 font-semibold text-sm">{info.value}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Availability badge -->
        <div class="flex items-center gap-3 p-4 bg-emerald-50 rounded-2xl border border-emerald-100">
          <div class="w-3 h-3 bg-emerald-400 rounded-full animate-pulse"></div>
          <p class="text-emerald-700 font-semibold text-sm">Tersedia untuk proyek freelance & kolaborasi</p>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100" data-animate>
        <form class="space-y-5" onsubmit="return false;">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2" for="name">Your Name</label>
              <input
                id="name"
                type="text"
                placeholder="Nama Lengkap"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-700 text-sm placeholder-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-blue-400 transition-all"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2" for="email">Email Address</label>
              <input
                id="email"
                type="email"
                placeholder="email@anda.com"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-700 text-sm placeholder-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-blue-400 transition-all"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2" for="subject">Subject</label>
            <input
              id="subject"
              type="text"
              placeholder="Topik Diskusi"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-700 text-sm placeholder-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-blue-400 transition-all"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2" for="message">Message</label>
            <textarea
              id="message"
              rows="5"
              placeholder="Jelaskan kebutuhan teknis Anda..."
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-700 text-sm placeholder-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-blue-400 transition-all resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-blue-200 hover:shadow-xl hover:shadow-blue-300 hover:-translate-y-0.5 flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
            Send Message
          </button>
        </form>
      </div>

    </div>
  </div>
</section>