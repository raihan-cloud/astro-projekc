---
const socials = [
  { href: 'https://github.com/raihan-cloud', icon: 'github',   label: 'GitHub'    },
  { href: '#', icon: 'linkedin', label: 'LinkedIn'  },
  { href: '#', icon: 'twitter',  label: 'Twitter'   },
  { href: '#', icon: 'instagram', label: 'Instagram' },
];
---

<section id="home" class="min-h-screen flex items-center pt-20 pb-16 bg-gradient-to-br from-slate-50 via-white to-blue-50 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">

    <!-- Left: Text -->
    <div class="space-y-6">
      <p class="text-blue-600 font-semibold tracking-widest text-sm uppercase animate-fade-up">Hello, I Am</p>

      <h1 class="font-display font-extrabold text-5xl md:text-6xl text-slate-800 leading-tight animate-fade-up animation-delay-200">
        Raihan <span class="text-blue-600">Muzaffar</span>
      </h1>

      <p class="text-slate-500 text-lg font-medium animate-fade-up animation-delay-400">
        Cloud Engineer & DevOps Specialist
      </p>

      <p class="text-slate-400 text-base leading-relaxed max-w-md animate-fade-up animation-delay-600">
        Saya berfokus pada pembangunan infrastruktur cloud yang tangguh, otomatisasi alur kerja DevOps, dan pengembangan solusi sistem cerdas berbasis IoT.
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap gap-4 animate-fade-up animation-delay-600">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-7 py-3 rounded-full shadow-lg shadow-blue-200 hover:shadow-xl hover:shadow-blue-300 transition-all duration-200 hover:-translate-y-0.5"
        >
          Work Together
        </a>
        <a
          href="#"
          class="inline-flex items-center gap-2 border-2 border-blue-200 text-blue-600 font-semibold px-7 py-3 rounded-full hover:bg-blue-50 transition-all duration-200 hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Get My CV
        </a>
      </div>

      <!-- Socials -->
      <div class="flex items-center gap-4 pt-2 animate-fade-up animation-delay-600">
        {socials.map(s => (
          <a
            href={s.href}
            aria-label={s.label}
            target="_blank"
            class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 hover:text-blue-600 hover:border-blue-400 hover:bg-blue-50 transition-all duration-200"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              {s.icon === 'github'    && <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.167 6.839 9.49.5.09.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.34-3.369-1.34-.454-1.154-1.11-1.46-1.11-1.46-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.577.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>}
              {s.icon === 'linkedin'  && <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>}
              {s.icon === 'twitter'   && <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>}
              {s.icon === 'instagram' && <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>}
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Right: Image with blob -->
    <div class="relative flex justify-center items-center">
      <!-- Blob shapes -->
      <div class="absolute w-80 h-80 bg-blue-100 rounded-full blur-3xl opacity-60 animate-blob"></div>
      <div class="absolute w-64 h-64 bg-indigo-200 rounded-full blur-2xl opacity-40 animate-blob animation-delay-400" style="top:20%;left:10%"></div>

      <!-- Profile image placeholder -->
      <div class="relative z-10 w-72 h-72 md:w-80 md:h-80 rounded-full overflow-hidden border-4 border-white shadow-2xl shadow-blue-100">
        <!-- Logo/Avatar Placeholder -->
        <div class="w-full h-full bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center">
          <span class="text-white text-7xl font-bold font-display">RM</span>
        </div>
      </div>

      <!-- Decorative ring -->
      <div class="absolute w-[340px] h-[340px] md:w-[360px] md:h-[360px] border-2 border-dashed border-blue-200 rounded-full animate-spin" style="animation-duration:20s"></div>

      <!-- Stats floating cards -->
      <div class="absolute -left-4 top-1/3 bg-white rounded-2xl shadow-xl p-3 flex items-center gap-3 border border-slate-100 animate-fade-in animation-delay-600">
        <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
             <path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/>
           </svg>
        </div>
        <div>
          <p class="font-display font-bold text-slate-800 text-sm">20+</p>
          <p class="text-slate-400 text-xs">Projects Completed</p>
        </div>
      </div>

      <div class="absolute -right-4 bottom-1/3 bg-white rounded-2xl shadow-xl p-3 flex items-center gap-3 border border-slate-100 animate-fade-in animation-delay-400">
        <div class="w-10 h-10 bg-cyan-50 rounded-xl flex items-center justify-center text-cyan-600">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
             <path d="M13 10V3L4 14h7v7l9-11h-7z" stroke-linecap="round" stroke-linejoin="round"/>
           </svg>
        </div>
        <div>
          <p class="font-display font-bold text-slate-800 text-sm">High</p>
          <p class="text-slate-400 text-xs">System Uptime</p>
        </div>
      </div>
    </div>

  </div>
</section>  