---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-8">
  <div class="max-w-6xl mx-auto px-6">

    <div class="grid md:grid-cols-3 gap-12 pb-12 border-b border-slate-800">

      <!-- Brand -->
      <div class="space-y-4">
        <a href="#home" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-display font-bold text-sm shadow-lg shadow-blue-900/20">
            R
          </div>
          <span class="font-display font-bold text-white text-lg tracking-tight">Raihan <span class="text-blue-400">Muzaffar</span></span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-xs">
          Membangun infrastruktur cloud yang tangguh dan backend yang efisien. Berfokus pada DevOps, automasi, dan sistem IoT.
        </p>
        <div class="flex gap-3">
          {socials.map(s => (
            <a
              href={s.href}
              aria-label={s.label}
              target="_blank"
              class="w-9 h-9 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-blue-600 transition-all duration-200"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d={s.d} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-display font-bold text-white mb-5">Navigasi</h4>
        <ul class="space-y-3">
          {['Home','About','Services','Projects','Contact'].map(link => (
            <li>
              <a
                href={`#${link.toLowerCase()}`}
                class="text-slate-400 hover:text-blue-400 text-sm transition-colors flex items-center gap-2 group"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600 opacity-0 group-hover:opacity-100 transition-opacity"></span>
                {link}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact snippet -->
      <div>
        <h4 class="font-display font-bold text-white mb-5">Kontak Pribadi</h4>
        <ul class="space-y-4 text-sm text-slate-400">
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
            </svg>
            raihanmuzaffar2319@gmail.com
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
            </svg>
            Indonesia
          </li>
          <li class="flex items-center gap-3">
            <div class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse shadow-lg shadow-emerald-900/40"></div>
            <span class="text-emerald-400 font-medium">Ready for new challenges</span>
          </li>
        </ul>
      </div>

    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {new Date().getFullYear()} Raihan Muzaffar. All rights reserved.</p>
      <p>Membangun dengan sistem yang efisien dan aman.</p>
    </div>

  </div>
</footer>